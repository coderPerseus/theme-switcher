{
  "publisher": "luckySnail",
  "name": "theme-switcher",
  "displayName": "Theme Switcher",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "description": "Quickly switch themes with status bar, command palette, and auto time-based switching",
  "author": "luckySnail",
  "license": "MIT",
  "homepage": "https://luckysnail.cn/",
  "repository": {
    "type": "git",
    "url": "https://github.com/coderPerseus/theme-switcher"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "main": "./dist/index.cjs",
  "icon": "res/icon.png",
  "files": [
    "LICENSE.md",
    "dist/*",
    "res/*"
  ],
  "engines": {
    "vscode": "^1.97.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "theme-switcher.quickMenu",
        "title": "Theme Switcher: Quick Menu"
      },
      {
        "command": "theme-switcher.selectTheme",
        "title": "Theme Switcher: Select Theme"
      },
      {
        "command": "theme-switcher.setDayTheme",
        "title": "Theme Switcher: Set Day Theme"
      },
      {
        "command": "theme-switcher.setNightTheme",
        "title": "Theme Switcher: Set Night Theme"
      },
      {
        "command": "theme-switcher.toggleAutoSwitch",
        "title": "Theme Switcher: Toggle Auto Switch"
      },
      {
        "command": "theme-switcher.configureSchedule",
        "title": "Theme Switcher: Configure Schedule"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Theme Switcher",
      "properties": {
        "theme-switcher.dayTheme": {
          "type": "string",
          "default": "Default Light Modern",
          "description": "Theme to use during daytime"
        },
        "theme-switcher.nightTheme": {
          "type": "string",
          "default": "Default Dark Modern",
          "description": "Theme to use during nighttime"
        },
        "theme-switcher.autoSwitch": {
          "type": "boolean",
          "default": false,
          "description": "Automatically switch themes based on time"
        },
        "theme-switcher.dayStartHour": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "maximum": 23,
          "description": "Hour when daytime starts (0-23)"
        },
        "theme-switcher.nightStartHour": {
          "type": "number",
          "default": 19,
          "minimum": 0,
          "maximum": 23,
          "description": "Hour when nighttime starts (0-23)"
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --external vscode",
    "dev": "nr build --watch --sourcemap",
    "prepare": "nr update",
    "update": "vscode-ext-gen --output src/generated/meta.ts",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "nr build",
    "release": "bumpp",
    "ext:package": "vsce package --no-dependencies",
    "ext:publish": "vsxpub --no-dependencies"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@antfu/ni": "^28.0.0",
    "@types/node": "^25.0.3",
    "@types/vscode": "^1.97.0",
    "@vscode/vsce": "^3.7.1",
    "bumpp": "^10.3.2",
    "eslint": "^9.39.2",
    "ovsx": "^0.10.7",
    "reactive-vscode": "^1.0.0-beta.2",
    "taze": "^19.9.2",
    "tsdown": "^0.19.0-beta.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "vscode-ext-gen": "^1.5.1",
    "vsxpub": "^0.1.2"
  }
}
